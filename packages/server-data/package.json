  },
  "dependencies": {
    "@firstscene/story-schema": "workspace:*",
    "pg": "8.23.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
