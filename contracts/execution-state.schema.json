{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Execution ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "specVersion",
    "createdAt",
    "status",
    "tasks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "const": "FirstScene"
    },
    "specVersion": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "status": {
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "BLOCKED_EXTERNAL",
        "LOCAL_PRODUCT_READY",
        "PUBLIC_RELEASE_READY"
      ]
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P[0-9]{2}-T[0-9]{2}$"
          },
          "phase": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "commandIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "acceptance": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string"
            }
          },
          "requirementIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^R[0-9]{2}$"
            }
          },
          "gate": {
            "enum": [
              "local",
              "public"
            ]
          },
          "weight": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "PENDING",
              "IN_PROGRESS",
              "VERIFYING",
              "DONE",
              "BLOCKED_EXTERNAL",
              "FAILED_REPAIR"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "commit": {
            "type": [
              "string",
              "null"
            ]
          },
          "startedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "actorType": {
            "enum": [
              "agent",
              "human",
              null
            ]
          }
        },
        "required": [
          "id",
          "phase",
          "title",
          "dependencies",
          "outputs",
          "commandIds",
          "acceptance",
          "requirementIds",
          "gate",
          "weight",
          "status",
          "attempts",
          "blockers",
          "evidence",
          "commit"
        ]
      }
    }
  }
}
