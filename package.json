{
  "name": "firstscene-workspace",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm --filter @firstscene/web dev",
    "build:packages": "node tools/build-packages.mjs",
    "build": "pnpm build:packages && pnpm content:check && pnpm --filter @firstscene/web build && node tools/prepare-standalone.mjs",
    "lint": "eslint . && prettier --check \"{apps,packages}/**/*.{ts,tsx}\" \"tools/**/*.mjs\"",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "check:state": "node tools/check-state.mjs",
    "test:unit": "vitest run",
    "storybook:build": "pnpm --filter @firstscene/ui-lab build",
    "content:check": "pnpm --filter @firstscene/story-schema build && pnpm --filter @firstscene/content-compiler build && node tools/generate-classics.mjs --check && node tools/content-check.mjs",
    "test:db": "pnpm --filter @firstscene/server-data build && vitest run --config vitest.db.config.ts",
    "test:api": "node tools/run-browser-tests.mjs --api",
    "test:e2e": "node tools/run-browser-tests.mjs --project=chromium",
    "test:e2e:webkit": "node tools/run-browser-tests.mjs --project=webkit",
    "test:a11y": "node tools/run-browser-tests.mjs --project=chromium tests/e2e/a11y.spec.ts",
    "test:visual": "node tools/visual/collect.mjs",
    "test:perf": "node tools/performance/run.mjs",
    "pack:smoke": "pnpm build:packages && node tools/pack-smoke.mjs",
    "test:security": "node tools/security-check.mjs",
    "assets:plan": "node tools/image-pipeline/cli.mjs plan",
    "assets:import": "node tools/image-pipeline/cli.mjs import",
    "assets:optimize": "node tools/image-pipeline/cli.mjs optimize",
    "assets:verify": "node tools/image-pipeline/cli.mjs verify",
    "assets:generate:api": "node tools/image-pipeline/cli.mjs api",
    "check:full": "node tools/full-check.mjs",
    "check:ci": "node tools/full-check.mjs --ci",
    "check:qa": "node tools/full-check.mjs --qa",
    "check:release": "node tools/full-check.mjs",
    "db:up": "pnpm --filter @firstscene/server-data build && node tools/database/cli.mjs up",
    "db:migrate": "pnpm --filter @firstscene/server-data build && node tools/database/cli.mjs migrate",
    "db:cleanup": "pnpm --filter @firstscene/server-data build && node tools/database/cli.mjs cleanup",
    "db:prepare-test": "pnpm --filter @firstscene/server-data build && node tools/database/prepare-test.mjs",
    "deploy:preflight": "node tools/deploy-preflight.mjs",
    "deploy:smoke": "node tools/deploy-smoke.mjs",
    "assets:begin": "node tools/image-pipeline/cli.mjs begin",
    "assets:review": "node tools/image-pipeline/cli.mjs review",
    "assets:preview": "node tools/image-pipeline/cli.mjs preview",
    "db:ci:up": "node tools/database/ci-service.mjs up",
    "db:ci:down": "node tools/database/ci-service.mjs down",
    "db:ci:verify": "node tools/database/verify-ci.mjs",
    "container:build": "docker build --progress=plain --tag firstscene:local-validated .",
    "container:smoke": "node tools/container-smoke.mjs",
    "test:startup": "node tools/startup-smoke.mjs",
    "docs:export": "node tools/export-public-docs.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "typescript-eslint": "8.73.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vitest": "5.1.0",
    "@playwright/test": "1.65.1",
    "@axe-core/playwright": "4.14.0",
    "tsx": "4.23.15",
    "@firstscene/tokens": "workspace:*",
    "@firstscene/ui": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@firstscene/content-compiler": "workspace:*",
    "sharp": "0.35.5",
    "ajv": "8.20.0",
    "@firstscene/reader-core": "workspace:*",
    "@firstscene/server-data": "workspace:*",
    "yaml": "2.9.1",
    "lighthouse": "13.6.0"
  }
}
